  <!-- Include html2canvas -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<!-- Include jsPDF -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<script>
    function pdfFromHTML(html){
      const { jsPDF } = window.jspdf;

      // Create a new PDF document
      const pdf = new jsPDF();

      // Get the HTML content
          const htmlString = html
                // Create a temporary DOM element from the HTML string
      const tempElement = document.createElement("div");
      tempElement.innerHTML = htmlString;
      document.body.appendChild(tempElement);

      // Use html2canvas to render the content into an image
      html2canvas(tempElement, {
        scale: 2, // Increase resolution
        useCORS: true, // Handle cross-origin images
      }).then((canvas) => {
        const imgData = canvas.toDataURL("image/png");

        // Add the image to the PDF
        const pageWidth = pdf.internal.pageSize.getWidth();
        const pageHeight = pdf.internal.pageSize.getHeight();
        const imgWidth = canvas.width;
        const imgHeight = canvas.height;
        const ratio = Math.min(pageWidth / imgWidth, pageHeight / imgHeight);

        const finalWidth = imgWidth * ratio;
        const finalHeight = imgHeight * ratio;

        pdf.addImage(imgData, "PNG", 0, 0, finalWidth, finalHeight);

        // Save the PDF
        pdf.save("arabic-content.pdf");
      });
    }
</script>
<script>
    function downloadPDF(url) {
        try {
            axios(url).then(function (response) {
                pdfFromHTML(response.data)
            });
        } catch {
            console.error("Please Add Axios CDN");
        }
    }
</script>