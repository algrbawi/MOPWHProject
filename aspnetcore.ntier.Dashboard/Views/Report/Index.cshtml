@using aspnetcore.ntier.Dashboard.Models.DashboardUser
@model IndexReportViewModel

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        td {
            padding: 10px;
            width: 50%;
        }

        table, th, td {
            border: 1px solid black;
            text-align: center
        }

    </style>

}



<div class="d-flex justify-content-around">
    <div>
        <div class="text-center">
            <h4>المملكة الاردنية الهاشمية</h4>
            <h4>وزارة الاشغال العامة و الاسكان - وحدة الاوزان المحورية</h4>
            <h4>(@Model.Site.SiteTitle)</h4>
            <h4>تقرير سنوي</h4>
        </div>
    </div>
    <div>
        <img src="~/images/img1.png" width="200" />
    </div>
</div>

<div class="row">

    <div class="container mt-5 col-4">
        <div class="card shadow p-4">
            @* <h2 class="text-center mb-4">Simple Search</h2> *@
            <form asp-action="GetReportResult">
                <input asp-for="SiteId" hidden />
                <div class="mb-3">
                    <label for="input1" class="form-label">التاريخ</label>
                    <input class="form-control" asp-for="Date" type="date" />

                </div>
                <div class="mb-3">
                    <label asp-for="DateType" class="form-label">نوع البحث</label>
                    <select class="form-select" asp-for="DateType">
                        <option value="0" selected>يومي</option>
                        <option value="1">شهري</option>
                        <option value="2">سنوي</option>
                    </select>

                </div>
                @*        <div class="mb-3">
                    <label for="input2" class="form-label">نوع البحث</label>
                    <input class="form-control" asp-for="DateType" />
                </div> *@
                <div class="text-center">
                    <button type="submit" class="btn btn-primary">بحث</button>
                </div>
            </form>
        </div>
    </div>

</div>
@if (Model.Weights.Count() > 0)
{
    <div class="container d-flex justify-content-center w-50 mt-5">
        <table class="table">
            <tr>
                <td><h5>عدد الشاحنات</h5></td>
                <td><h5>@Model.Weights.Count()</h5></td>
            </tr>
            <tr>
                <td><h5> عدد الشاحنات المخالفة</h5></td>
                <td><h5>@Model.Weights.Where(v => v.VioPrice > 0).Count()</h5></td>
            </tr>
            <tr>
                <td><h5>مجموع الاوزان المخالفة بالطن</h5></td>
                <td><h5>@Model.Weights.Where(v => v.VioPrice > 0).Sum(x => x.VioWeight)</h5></td>
            </tr>
            <tr>
                <td><h5>قيمة المخالفات بالدينار</h5></td>
                <td><h5>@Model.Weights.Where(v => v.VioPrice > 0).Sum(x => x.VioPrice)</h5></td>
            </tr>
            <tr>
                <td><h5>مخالفات أكثر من 5 طن</h5></td>
                <td><h5>@Model.Weights.Where(v => v.VioWeight >= 6000 && v.VioPrice > 0).Count()</h5></td>
            </tr>
        </table>
    </div>
}


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
          $(document).ready(function() {
            $('#DateType').select2();
        });

    </script>
}
