@using aspnetcore.ntier.DTO.Enum
@using aspnetcore.ntier.Dashboard.Models.DashboardUser
@using aspnetcore.ntier.Dashboard.Models.DashboardUser.Views
@model ReportDetailsResponseViewModel
@{
    var report = Model.ReportData;
    var IsReportDataNotNull = report?.ReportData is not null && report.ReportData.Count() > 0;
    var yearsListItems = new List<SelectListItem>();
    var currentYear = DateTime.Now.Year;
    for (int i = 1800; i <= currentYear; i++)
    {
        yearsListItems.Add(new SelectListItem { Value = new DateTime(i, 01, 01).ToString("MM/dd/yyyy"), Text = i.ToString(), Selected = i == currentYear });
    }
    ViewBag.Title = "التقرير";
}
@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        .first-table > td {
            padding: 10px;
            width: 50%;
        }

        table, th, td {
            border: 1px solid black;
            text-align: center
        }

        .second-table-header {
            background-color: #dcdcdc;
        }

    </style>
}

<div class="d-flex justify-content-around">
    <div>
        <div class="text-center">
            <h4>المملكة الاردنية الهاشمية</h4>
            <h4>وزارة الاشغال العامة و الاسكان - وحدة الاوزان المحورية</h4>
            <h4> @Model.Site?.SiteName (@Model.Site?.SiteTitle)</h4>
            <h4>تقرير @Model.DateTypeText</h4>
        </div>
    </div>
    <div>
        <img src="~/images/img1.png" width="200" />
    </div>
</div>

<div class="row">

    <div class="container mt-5 col-4">
        <div class="card shadow p-4">
            @* <h2 class="text-center mb-4">Simple Search</h2> *@
            <form asp-action="ReportDetails" method="get" id="ReportDetailsForm" style="display:none">
                <input asp-for="SiteId" hidden />
                <div class="mb-3">
                    <label for="date-label" class="form-label date-label"></label>
                    <input id="day" class="form-control date-filter" asp-for="SearchDate" type="date" disabled />
                    <input id="month" class="form-control date-filter" asp-for="SearchDate" type="month" disabled />
                    <select id="year" asp-items="yearsListItems" class="form-select date-filter" asp-for="SearchDate" disabled></select>
                </div>
                <div class="bill-filter-type">
                    <div class="mb-3">
                        <label for="input1" class="form-label">إلى</label>
                        <input class="form-control" asp-for="SearchDateTo" type="date" />
                    </div>
                    <div class="mb-3">
                        <label for="input1" class="form-label">رقم الشاحنة</label>
                        <input class="form-control" asp-for="TruckNumber" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ReportType" class="form-label">نوع البحث</label>
                    <select class="form-select" asp-for="ReportType">
                        <option value="0" selected>يومي</option>
                        <option value="1">شهري</option>
                        <option value="2">سنوي</option>
                        <option value="3">تقرير وصولات المخالفات</option>
                    </select>

                </div>
                @*        <div class="mb-3">
                    <label for="input2" class="form-label">نوع البحث</label>
                    <input class="form-control" asp-for="DateType" />
                </div> *@
                <div class="text-center">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fas fa-search"></i>
                        بحث
                    </button>

                    @if (IsReportDataNotNull)
                    {
                        <a class="btn btn-primary" onclick="downloadPDF()">
                            <i class="fa fa-regular fa-download"></i>
                            تحميل
                        </a>
                        @if (User.IsInRole("AllowToEdit") || User.IsInRole("SuperAdmin"))
                        {
                            <a class="btn btn-primary" asp-action="Edit" asp-controller="Weight" asp-route-SiteId="@Model.SiteId">
                                <i class="fa fas fa-edit"></i>
                                تعديل
                            </a>
                        }

                    }
                </div>
            </form>
        </div>
    </div>

</div>
@if (IsReportDataNotNull)
{
    <div class="container d-flex justify-content-center w-50 mt-5">
        <table class="table first-table">
            <tr>
                <td><h5>عدد الشاحنات</h5></td>
                <td><h5>@report.TotalTrucks</h5></td>
            </tr>
            <tr>
                <td><h5> عدد الشاحنات المخالفة</h5></td>
                <td><h5>@report.TotalViolationTrucks</h5></td>
            </tr>
            <tr>
                <td><h5>مجموع الاوزان المخالفة بالطن</h5></td>
                <td><h5>@report.TotalViolationWeight</h5></td>
            </tr>
            <tr>
                <td><h5>قيمة المخالفات بالدينار</h5></td>
                <td><h5>@report.TotlaViolationPrice</h5></td>
            </tr>
            <tr>
                <td><h5>مخالفات أكثر من 5 طن</h5></td>
                <td><h5>@report.TotlaViolationNumberMoreThan5</h5></td>
            </tr>
        </table>
    </div>



    @if (Model.ReportType == ReportType.daily)
    {
        <div class="container d-flex justify-content-center mt-5">

            <table class="table mt-5 second-table">
                <tr class="second-table-header">
                    <th>الرقم</th>
                    <th>رقم العملية</th>
                    <th>التاريخ</th>
                    <th>الوقت</th>
                    <th>رقم المركبة</th>
                    <th>الجنسية</th>
                    <th>التصنيف</th>
                    <th>وزن المركبة</th>
                    <th>الوزن المسموح</th>
                    <th>فرق الوزن</th>
                    <th>المخالفة</th>
                    <th>الحمولة</th>
                    <th>الملاحظات</th>
                    <th>المستخدم</th>
                </tr>
                @foreach (var item in report.ReportData)
                {
                    <tr>
                        <td>@item.Number</td>
                        <td> @item.OperationNumber</td>
                        <td>@item.DateOnly</td>
                        <td>@item.TimeOnly</td>
                        <td>@item.TruckNumber </td>
                        <td>@item.Nationality</td>
                        <td>@item.Classification</td>
                        <td> @item.TruckWeiht</td>
                        <td>@item.AllowedWeight </td>
                        <td> @item.DiifWeight</td>
                        <td>@item.Violation</td>
                        <td>@item.ProductName</td>
                        <td>@item.WeightNote</td>
                        <td>@item.UserName</td>
                    </tr>
                }

            </table>
        </div>
    }
    else if (Model.ReportType == ReportType.bill)
    {
        <div class="container d-flex justify-content-center mt-5">

            <table class="table mt-5 second-table">
                <tr class="second-table-header">
                    <th>رقم العملية</th>
                    <th>التاريخ</th>
                    <th>الوقت</th>
                    <th>رقم المركبة</th>
                    <th>الجنسية</th>
                    <th>التصنيف</th>
                    <th>وزن المركبة</th>
                    <th>الوزن المسموح</th>
                    <th>فرق الوزن</th>
                    <th>المخالفة</th>
                    <th>رقم الوصل</th>
                    <th>رقم الضبط</th>
                    <th>إسم دافع الفاتورة</th>
                    <th>المستخدم</th>
                </tr>
                @foreach (var item in report.ReportData)
                {
                    <tr>
                        <td> @item.OperationNumber</td>
                        <td>@item.DateOnly</td>
                        <td>@item.TimeOnly</td>
                        <td>@item.TruckNumber </td>
                        <td>@item.Nationality</td>
                        <td>@item.Classification</td>
                        <td> @item.TruckWeiht</td>
                        <td>@item.AllowedWeight </td>
                        <td> @item.DiifWeight</td>
                        <td>@item.Violation</td>
                        <td>@item.Bill_Num</td>
                        <td>@item.Vio_Num</td>
                        <td>@item.Bill_Name</td>
                        @*               <td>@item.ProductName</td>
                        <td>@item.DriverName</td> *@
                        <td>@item.UserName</td>
                    </tr>
                }

            </table>
        </div>
    }
    else
    {

        <div class="container d-flex justify-content-center mt-5">

            <table class="table mt-5 second-table">
                <tr class="second-table-header">
                    <th>الرقم</th>
                    <th>التاريخ</th>
                    <th>عدد عمليات التوزين</th>
                    <th>عدد المركبات غير المخالفة </th>
                    <th>عدد المركبات المخالفة</th>
                    <th>عدد المركبات المخالفة <span> &lt; </span> 5 </th>
                    <th>عدد المركبات المخالفة <span> &gt; </span> 5 </th>
                    <th>مجموع الاوزان المخالف عليها</th>
                    <th>مجموع المخالفات دينار</th>
                </tr>
                @foreach (var item in report.ReportData)
                {
                    <tr>
                        <td>@item.Number</td>
                        <td>@item.DateOnly</td>
                        <td>@item.TotalNumberWeights</td>
                        <td>@item.TotalTruckesNotInViolation</td>
                        <td>@item.TotalTruckesViolation</td>
                        <td>@item.TotalTruckesViolationLessThan5</td>
                        <td>@item.TotalTruckesViolationGreaterThan5</td>
                        <td>@item.TotalViolationWeights</td>
                        <td>@item.TotalViolationPrice</td>
                    </tr>
                }

            </table>
        </div>
    }
}


@section Scripts {
    @await Html.PartialAsync("_PdfScripts.cshtml")
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
           $(document).ready(function() {
             $("#ReportDetailsForm").show();
             $('#ReportType').select2();
             $('#year').select2();
             $('#ReportType').change();
         });

         function downloadPDF(){
         window.open("@Url.Action("DownloadReport")"+window.location.search, '_blank');
         }

        $('#ReportType').on('change', function(e) {
            $(".date-filter").prop('disabled', true);
            $(".date-filter").hide();
            $('#year').next(".select2-container").hide();
            $(".bill-filter-type").hide();
            $(".bill-filter-type").hide();
            $(".other-bill-filter-type").hide();
            var dateLabel = $(".date-label");
            if(this.value ==0){
                var dayFilter=   $("#day");
                dayFilter.removeAttr("disabled")
                dayFilter.show();
                dateLabel.text("التاريخ")
            }
            else if(this.value ==1){
                var monthFilter=   $("#month");
                monthFilter.removeAttr("disabled")
                monthFilter.show();
                dateLabel.text("الشهر")


            }
            else if(this.value ==2){
                var yearFilter= $("#year");
                yearFilter.removeAttr("disabled")
                yearFilter.next(".select2-container").show();
                dateLabel.text("السنة")
            }
            else{
            $(".bill-filter-type").show();
            var dayFilter=   $("#day");
            dayFilter.removeAttr("disabled")
            dayFilter.show();
            dateLabel.text("من")
            }
         });
    </script>
}
