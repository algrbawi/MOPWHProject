@model LoginViewModel
@{
    Layout = "_GuestLayout";
    ViewBag.Title = "تسجيل الدخول";
}
<!-- Login 13 - Bootstrap Brain Component -->
<section class="py-3 py-md-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5 col-xxl-4">
                <div class="card border border-light-subtle rounded-3 shadow-sm">
                    <div class="card-body p-3 p-md-4 p-xl-5">
                        <div class="d-flex flex-row justify-content-center">
                            <img src="/images/img2.png" width="100" />
                        </div>

                        @*      <div class="text-center mb-3">
                        <a href="#!">
                        <img src="./assets/img/bsb-logo.svg" alt="BootstrapBrain Logo" width="175" height="57">
                        </a>
                        </div> *@
                        <h2 class="fs-6 fw-normal text-center text-secondary mb-4">تسجيل الدخول</h2>
                        <form method="post">
                            <div class="row gy-2 overflow-hidden">
                                <div class="col-12">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Email" class="form-control" placeholder="تسجيل الدخول">
                                        <label for="email" class="form-label">البريد الالكتروني</label>
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                                <div class="col-12">
                                    <div class="form-floating mb-3">
                                        <input type="password" class="form-control" asp-for="Password" placeholder="كلمة المرور">
                                        <label for="password" class="form-label">كلمة المرور</label>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                                <div class="col-12">
                                    <div class="d-flex gap-2 justify-content-between">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" asp-for="RemmberMe">
                                            <label class="form-check-label text-secondary" for="rememberMe">
                                                تذكرني
                                            </label>
                                        </div>
                                        @* <a href="#!" class="link-primary text-decoration-none">Forgot password?</a> *@
                                    </div>
                                </div>
                                <div class="text-danger" asp-validation-summary="ModelOnly">
                                </div>
                                <div class="col-12">
                                    <div class="d-grid my-3">
                                        <button class="btn btn-primary btn-lg" type="submit">تسجيل الدخول</button>
                                    </div>
                                </div>
                                <div class="col-12">
                                    @* <p class="m-0 text-secondary text-center">Don't have an account? <a href="#!" class="link-primary text-decoration-none">Sign up</a></p> *@
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>