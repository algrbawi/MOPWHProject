@using aspnetcore.ntier.Dashboard.Models.DashboardUser
@model EditWeightViewModel
@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
}
@{
    ViewBag.Title = "تعديل";
}
<div class="row">

    <div class="container mt-5 col-4">
        <div class="card shadow p-4">
            <form asp-action="Edit" method="get">
                <input asp-for="SiteId" hidden />

                <div class="mb-3">
                    <label asp-for="WId" class="form-label">رقم الوزن</label>
                    <input asp-for="WId" class="form-control" />
                    <span asp-validation-for="WId" class="text-danger"></span>

                </div>
                <div class="text-center">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fas fa-search"></i>
                        بحث
                    </button>
                    <a class="btn btn-primary" asp-controller="Report" asp-action="ReportDetails" asp-route-SiteId="@Model.SiteId">
                        عودة
                        <i class="fa fa-arrow-circle-left" aria-hidden="true"></i>
                    </a>

                </div>
            </form>

        </div>
    </div>

</div>
<div class="container mt-5">
    @if (Model.WId > 0)
    {
        @if (TempData["MessageStatus"] is not null)
        {
            <div class="alert alert-success" role="alert">
                @TempData["MessageStatus"]
            </div>
            @(TempData["MessageStatus"] = null)

        }
        <form asp-action="Edit" method="post">
            <!-- Name -->
            <input asp-for="WId" hidden />
            <input asp-for="SiteId" hidden />

            <div class="mb-3">
                <label asp-for="Bill_Name" class="form-label">إسم الفاتورة</label>
                <input asp-for="Bill_Name" class="form-control" placeholder="إسم الفاتورة">
                <span asp-validation-for="Bill_Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Bill_Num" class="form-label">رقم الفاتورة</label>
                <input asp-for="Bill_Num" class="form-control" placeholder="رقم الفاتورة">
                <span asp-validation-for="Bill_Num" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Vio_Num" class="form-label">رقم المخالفة</label>
                <input asp-for="Vio_Num" class="form-control" placeholder="رقم المخالفة">
                <span asp-validation-for="Vio_Num" class="text-danger"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary">
                <i class="fa fas fa-save"></i>
                حفظ
            </button>

        </form>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
          $(document).ready(function() {
                setTimeout( "$('.alert').alert('close')",5000 );
        });
    </script>
}

